rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "mhacdeliverypaniqui112021@gmail.com";
    }

    function isApprovedRider() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/riders/$(request.auth.uid))
        && get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.approved == true;
    }

    match /settings/menu {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/menuDraft {
      allow read, write: if isAdmin();
    }

    match /settings/payment {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/businessHours {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create:
        if isSignedIn()
        && request.resource.data.customer.uid == request.auth.uid;

      allow read:
        if isAdmin()
        || (isApprovedRider() && (
       resource.data.assignedRiderUid == request.auth.uid
       || resource.data.assignedRiderEmail == request.auth.token.email
       || resource.data.riderUid == request.auth.uid
       || resource.data.riderEmail == request.auth.token.email
     ))
        || (isSignedIn() && resource.data.customer.uid == request.auth.uid);

      allow update:
        if isAdmin()
        || (isApprovedRider() && (
       resource.data.assignedRiderUid == request.auth.uid
       || resource.data.assignedRiderEmail == request.auth.token.email
       || resource.data.riderUid == request.auth.uid
       || resource.data.riderEmail == request.auth.token.email
     ));
    }

    match /orders/{orderId}/messages/{messageId} {
      allow read:
        if isSignedIn()
        && (
          isAdmin()
          || get(/databases/$(database)/documents/orders/$(orderId)).data.customer.uid == request.auth.uid
        );

      allow create:
        if isSignedIn()
        && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/orders/$(orderId)).data.customer.uid == request.auth.uid
            && request.resource.data.senderRole == "customer"
            && request.resource.data.senderUid == request.auth.uid
          )
        );

      allow update, delete: if isAdmin();
    }

    match /orders/{orderId}/riderMessages/{messageId} {
      allow read:
        if isAdmin()
        || (
          isApprovedRider()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedRiderUid == request.auth.uid
        );

      allow create:
        if isAdmin()
        || (
          isApprovedRider()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.assignedRiderUid == request.auth.uid
          && request.resource.data.senderRole == "rider"
          && request.resource.data.senderUid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /riders/{uid} {
      allow read:
        if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create:
        if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.approved == false;

      allow update:
        if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.approved == resource.data.approved
        );

      allow delete: if isAdmin();
    }

    match /riderApplications/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /menuSeedLogs/{id} {
      allow create, read: if isAdmin();
    }
  }
}
